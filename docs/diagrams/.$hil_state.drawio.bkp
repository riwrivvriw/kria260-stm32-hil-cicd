        <mxCell id="fpga_dut" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#38bdf8;strokeWidth=3;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="&lt;b&gt;Target Under Test (DUT)&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;4&quot;&gt;&lt;b&gt;AMD Kria KR260 Robotics Starter Kit&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#38bdf8&quot;&gt;FPGA PL Fabric (Xilinx Zynq UltraScale+ MPSoC) + Linux PetaLinux PS&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&quot;left&quot; style=&quot;padding-left:14px;&quot;&gt;&amp;bull; &lt;b&gt;Virtual Video Device:&lt;/b&gt; &lt;font color=&quot;#10b981&quot;&gt;&lt;b&gt;/dev/video0 (v4l2loopback)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Vitis AI Vision DPU:&lt;/b&gt; &lt;u&gt;Inspects GI Cavity: LUMEN OPEN vs COLLAPSED&lt;/u&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Vitis AI Acoustic Anomaly Detector (DPU):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;- Trained on Normal Airflow sound baseline (16 kHz stereo PCM)&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;- Flags &lt;font color=&quot;#ef4444&quot;&gt;&lt;b&gt;ANOMALY / LEAK DETECTED&lt;/b&gt;&lt;/font&gt; on 3 kHz leak hiss&lt;/i&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Closed-Loop PID Engine:&lt;/b&gt; Sensor Fusion (Vision + Audio + Pressure)&lt;br&gt;&amp;bull; &lt;b&gt;Ultra-Fast Safety Interlock:&lt;/b&gt; Hardware logic cutoff &amp;lt; 10ns on E-Stop / Overpressure&lt;br&gt;&lt;br&gt;&lt;b&gt;PHYSICAL INTERFACE CONNECTOR ALLOCATION:&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;RPi Header (J10):&lt;/b&gt; I2C Master (Pin 5 SCL, Pin 3 SDA) with 1.8k Pull-Ups&lt;br&gt;&amp;bull; &lt;b&gt;PMOD 1 (J1 - Dedicated Audio):&lt;/b&gt; AXI I2S Receiver IP Core&lt;br&gt;&amp;nbsp;&amp;nbsp;- Pin 1: BCLK &amp;nbsp;|&amp;nbsp; Pin 2: WS (LRCLK) &amp;nbsp;|&amp;nbsp; Pin 3: SD (Data) &amp;nbsp;|&amp;nbsp; Pin 5: GND&lt;br&gt;&amp;bull; &lt;b&gt;PMOD 2 (J2 - Control &amp;amp; Safety IO):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- Pin 1: Air Pump PWM Output (10-bit pwm_controller.sv RTL)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Pin 2: Solenoid Purge Valve Output (Over-Expansion Vent)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Pin 3: Doctor Start/Stop Input (from STM32 PE13)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Pin 4: Doctor E-Stop Button Input (from STM32 PE11 - Cutoff)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Pin 7: Safety Tripped Status Output (to STM32 PE9)&lt;/div&gt;" vertex="1">
          <mxGeometry height="660" width="560" x="1440" y="240" as="geometry" />
        </mxCell>
