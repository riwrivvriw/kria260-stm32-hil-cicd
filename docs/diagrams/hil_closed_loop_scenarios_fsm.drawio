        </mxCell>

        <!-- Digital Audio I2S Pins -->
        <mxCell id="pin_i2s" value="&lt;b&gt;I2S2 Digital Audio Bus (Master TX / 16 kHz 16-bit):&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;PB13 (D18):&lt;/b&gt; I2S2_CK (BCLK / Continuous Bit Clock)&lt;br&gt;&amp;bull; &lt;b&gt;PB12 (D19):&lt;/b&gt; I2S2_WS (LRCLK / Word Select)&lt;br&gt;&amp;bull; &lt;b&gt;PB15 (D17):&lt;/b&gt; I2S2_SD (Serial PCM Data Out)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10.5;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="745" width="480" height="65" as="geometry" />
        </mxCell>

        <!-- I2C Target Bus -->
        <mxCell id="pin_i2c" value="&lt;b&gt;I2C1 Sensor Bus (Target / Address 0x58):&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;PB8 (D15):&lt;/b&gt; I2C1_SCL | &amp;bull; &lt;b&gt;PB9 (D14):&lt;/b&gt; I2C1_SDA&lt;br&gt;&lt;i&gt;*Requires Pull-ups (Integrated 1.8k on KR260 RPi Header J10)*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontColor=#3730a3;fontSize=10.5;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="820" width="480" height="55" as="geometry" />
        </mxCell>

        <!-- Dual E-Stop & Controls Pins -->
        <mxCell id="pin_estop_start" value="&lt;b&gt;Dual E-Stop &amp;amp; Actuation Signals (3.3V LVCMOS):&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;PE13 (D3):&lt;/b&gt; Doctor Start/Stop Button Output (&amp;rarr; KR260 Input)&lt;br&gt;&amp;bull; &lt;b&gt;PE11 (D5):&lt;/b&gt; Mock Doctor E-Stop Button Output (&amp;rarr; KR260 Input Cutoff)&lt;br&gt;&amp;bull; &lt;b&gt;PE9 (D6):&lt;/b&gt; KR260 Safety Tripped Status Input (&amp;larr; KR260 Output)&lt;br&gt;&amp;bull; &lt;b&gt;PE14 (D4):&lt;/b&gt; Solenoid Relief Valve Command Input (&amp;larr; KR260 Output)&lt;br&gt;&amp;bull; &lt;b&gt;PF15 (D2):&lt;/b&gt; Air Pump PWM Frequency/Duty Capture (&amp;larr; KR260 RTL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#f87171;fontColor=#991b1b;fontSize=10.5;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="885" width="480" height="95" as="geometry" />
        </mxCell>

        <!-- Ground Pin -->
        <mxCell id="pin_gnd" value="&lt;b&gt;Common Ground Reference:&lt;/b&gt; GND (Nucleo CN7 Pin 20 / CN8 Pin 9) &amp;harr; KR260 Common GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#475569;fontSize=10.5;align=center;" vertex="1" parent="1">
