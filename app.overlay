/*
 * DeviceTree Overlay สำหรับ STM32H563ZI (Nucleo-H563ZI)
 *
 * 1. I2C1: Target (Slave) จำลอง Sensor Registers ที่ Address 0x58
 *          - พิน D15 (PB8) = SCL (ช่อง CN7 pin 2)
 *          - พิน D14 (PB9) = SDA (ช่อง CN7 pin 4)
 * 2. I2C2: Controller (Master) สำหรับทดสอบ Loopback ข้ามขา D69 / D68
 *          - พิน D69 (PF1) = SCL (ช่อง CN9 pin 19)
 *          - พิน D68 (PF0) = SDA (ช่อง CN9 pin 21)
 * 3. Doctor Start/Stop Button (Output):
 *          - พิน D3 (PE13)
 * 4. Doctor Emergency Stop Button (Output):
 *          - พิน D5 (PE11)
 * 5. KR260 Solenoid Purge Valve Command (Input):
 *          - พิน D4 (PE14)
 * 6. KR260 Safety Tripped Status (Input):
 *          - พิน D6 (PE9)
 * 7. Leak Audio Digital I2S Output (Emulated Digital Mic):
 *          - BCLK (SCK) : พิน D18 (PB13) (CN7 pin 30)
 *          - WS (LRCLK) : พิน D19 (PB12) (CN7 pin 16)
 *          - SD (DOUT)  : พิน D17 (PB15) (CN7 pin 26)
 * 8. KR260 PWM Input:
 *          - พิน D2 (PF15)
 */

/ {
    aliases {
        hil-target            = &pressure_target;
        hil-master            = &i2c2;
        hil-audio-i2s         = &i2s2;
        kr260-pwm             = &kr260_pwm_input;
        kr260-start-stop      = &kr260_start_stop_output;
        kr260-estop-btn       = &kr260_estop_button_output;
        kr260-solenoid        = &kr260_solenoid_input;
        kr260-safety-tripped  = &kr260_safety_tripped_input;
        kr260-estop           = &kr260_safety_tripped_input;
    };

    kr260_hil_inputs {
        compatible = "gpio-keys";
        kr260_pwm_input: pwm_in {
            gpios = <&gpiof 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
            label = "KR260 Airpump PWM Capture Input (Arduino D2)";
        };
        kr260_solenoid_input: solenoid_in {
            gpios = <&gpioe 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
            label = "KR260 Solenoid Valve Control Input (Arduino D4)";
        };
        kr260_safety_tripped_input: safety_tripped_in {
            gpios = <&gpioe 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
            label = "KR260 Safety Tripped Status Input (Arduino D6)";
        };
    };

    kr260_hil_outputs {
        compatible = "gpio-leds";
        kr260_start_stop_output: start_stop_out {
            gpios = <&gpioe 13 GPIO_ACTIVE_HIGH>;
            label = "Mock Doctor Start/Stop Button Output to KR260 (Arduino D3)";
        };
        kr260_estop_button_output: estop_btn_out {
            gpios = <&gpioe 11 GPIO_ACTIVE_HIGH>;
            label = "Mock Doctor Emergency Stop Button Output to KR260 (Arduino D5)";
        };
    };
};

/* เปิดใช้งาน GPIO Controllers */
&gpiob { status = "okay"; };
&gpioe { status = "okay"; };
&gpiof { status = "okay"; };

/* I2C1: กำหนดเป็น Target (Slave) บนพิน D15 (SCL) / D14 (SDA) */
&i2c1 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>; /* 100 kHz */

    pressure_target: eeprom_slave@58 {
        compatible = "zephyr,i2c-target-eeprom";
        reg = <0x58>;
        size = <256>;
        auto-register;
    };
};

/* I2C2: กำหนดเป็น Controller (Master) บนพิน D69 (SCL) / D68 (SDA) สำหรับ Loopback */
&i2c2 {
    pinctrl-0 = <&i2c2_scl_pf1 &i2c2_sda_pf0>;
    pinctrl-names = "default";
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
};

/* ปลดการจองขาพิน PB13 / PB15 จาก Ethernet และ UCPD เพื่อให้ I2S2 นำไปใช้งานได้ */
&mac {
    status = "disabled";
};

&ucpd1 {
    status = "disabled";
};

/* I2S2: จำลอง Digital MEMS Microphone สำหรับสัญญาณเสียงลมรั่ว (Leak Audio)
 * - PB13 (Arduino D18) : BCLK
 * - PB12 (Arduino D19) : WS / LRCLK
 * - PB15 (Arduino D17) : SD / Serial Data Out
 */
&i2s2 {
    pinctrl-0 = <&i2s2_ck_pb13 &i2s2_ws_pb12 &i2s2_sdo_pb15>;
    pinctrl-names = "default";
    status = "okay";
};

